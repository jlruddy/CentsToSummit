# Kalshi Environment: demo | production
KALSHI_ENVIRONMENT=demo
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/demo_private_key.pem

# Execution & Capital
EXECUTION_MODE=paused
INITIAL_CAPITAL=5000.00
EQUITY_FLOOR=2000.00
DAILY_DRAWDOWN_KILL_SWITCH=500.00
POLL_INTERVAL_MS=1000

# Risk & Microstructure Limits
MAX_POSITION_DOLLARS_PER_MARKET=250.00
MAX_OPEN_MARKETS=5
MAX_ORDERS_PER_MINUTE=10
MIN_NET_EDGE_DOLLARS=0.02
MAX_SLIPPAGE_CENTS=3

# Tax-Hygiene Allowlist (JSON array)
ALLOWED_SERIES_PREFIXES=["KXBTC","KXETH","KXINX","KXFED","KXCPI"]
ENFORCE_FINANCIAL_ONLY=true

# AI Strategy Settings
STRATEGY_PROVIDER=stub_momentum
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=claude-3-5-sonnet-latest
LLM_TEMPERATURE=0.1
SYSTEM_PROMPT_OVERRIDE=
LLM_MIN_COOLDOWN_SEC=15
LLM_HEARTBEAT_SEC=60

# Telemetry & Web Server
DB_PATH=data/kalshi_telemetry.db
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Extra hostnames allowed to reach the control panel (loopback always allowed)
WEB_ALLOWED_HOSTS=[]
